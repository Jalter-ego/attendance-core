PORT=5000

# Cada instalación usa su propia base y su propio JWT_SECRET.
INSTITUTION_NAME=Mi Institución
INSTITUTION_TIMEZONE=America/La_Paz

# Orígenes exactos del frontend, separados por comas.
CORS_ORIGIN=http://localhost:5173

# SSL de la base de datos (false para Postgres local)
DB_SSL=false

# Base de datos - Lectura (Read)
DB_READ_HOST=localhost
DB_READ_PORT=5432
DB_READ_USERNAME=postgres
DB_READ_PASSWORD=postgres
DB_READ_NAME=attendance_db

# Base de datos - Escritura (Write)
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5432
DB_WRITE_USERNAME=postgres
DB_WRITE_PASSWORD=postgres
DB_WRITE_NAME=attendance_db

# Autenticación
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Plan de la instalación (los entrega la plataforma). Sin PLAN_MAX_* no hay límites.
# TENANT_ENV=test             # test | prod. Con test existen /demo/error y /demo/slow
# TENANT_PLAN=basic           # basic | standard | advanced (solo para mostrar el nombre)
# PLAN_MAX_STUDENTS=100
# PLAN_MAX_TEACHERS=10
# PLAN_MAX_COURSES=20

# Solo para crear el primer owner con pnpm instance:bootstrap.
# No se ejecuta al iniciar el servidor. No usar datos demo en clientes.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
