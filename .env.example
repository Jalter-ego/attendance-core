PORT=5000

# Orígenes del frontend, separados por comas. `*` vale como comodín de subdominio,
# porque el tenant se resuelve desde ahí (demo.localhost:5173).
# Usa solo `*` para abrirlo a cualquier origen.
CORS_ORIGIN=http://localhost:5173,http://*.localhost:5173,http://*.attlasian.test:5173

# SSL de la base de datos (false para Postgres local)
DB_SSL=false

# Base de datos - Lectura (Read)
DB_READ_HOST=localhost
DB_READ_PORT=5432
DB_READ_USERNAME=postgres
DB_READ_PASSWORD=postgres
DB_READ_NAME=attendance_db

# Base de datos - Escritura (Write)
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5432
DB_WRITE_USERNAME=postgres
DB_WRITE_PASSWORD=postgres
DB_WRITE_NAME=attendance_db

# Autenticación
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=8h
