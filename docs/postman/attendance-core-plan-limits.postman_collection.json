                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/demo/slow?ms=abc",
            "description": "Antes se confundía con «no enviado» y esperaba 2 s: la validación del pipe global lo convertía en NaN.",
