                  "pm.test('El mensaje indica el límite de estudiantes del plan', () => pm.expect(message).to.include('permite hasta ' + pm.collectionVariables.get('limitStudents') + ' estudiantes'));",
                  "pm.test('...y a cuánto llegaría la acción', () => pm.expect(message).to.include('llegaría a 10'));"
