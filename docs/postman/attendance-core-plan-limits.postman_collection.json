    {
      "name": "6. Métricas Prometheus",
      "description": "Prometheus consulta GET /metrics directo al puerto del backend. No lleva JWT.",
      "item": [
        {
          "name": "Métricas sin JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 sin token', () => pm.response.to.have.status(200));",
                  "const text = pm.response.text();",
                  "pm.test('Formato de texto de Prometheus', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));",
                  "pm.test('Expone http_requests_total', () => pm.expect(text).to.include('http_requests_total'));",
                  "pm.test('Expone http_request_duration_seconds', () => pm.expect(text).to.include('http_request_duration_seconds'));",
                  "pm.test('Expone nodejs_eventloop_lag_seconds', () => pm.expect(text).to.include('nodejs_eventloop_lag_seconds'));",
                  "pm.test('Expone nodejs_heap_size_used_bytes', () => pm.expect(text).to.include('nodejs_heap_size_used_bytes'));",
                  "pm.test('Expone process_resident_memory_bytes', () => pm.expect(text).to.include('process_resident_memory_bytes'));",
                  "pm.test('Cuenta los 401 (carpeta 1)', () => pm.expect(text).to.match(/http_requests_total\\{method=\"GET\",route=\"\\/core\\/api\\/v1\\/plan\\/usage\",status=\"401\"\\} \\d+/));",
                  "pm.test('Cuenta los 403 (carpetas 3 a 5)', () => pm.expect(text).to.match(/http_requests_total\\{method=\"POST\",route=\"\\/core\\/api\\/v1\\/users\",status=\"403\"\\} \\d+/));",
                  "pm.test('Usa el patrón de la ruta, no la URL real', () => pm.expect(text).to.include('route=\"/core/api/v1/modules/:moduleId/students/import\"'));",
                  "pm.test('No se cuenta a sí mismo', () => pm.expect(text).to.not.include('route=\"/core/api/v1/metrics\"'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metrics",
            "description": "Para P5: `http_requests_total{method,route,status}` (5xx con `status=~\"5..\"`), `http_request_duration_seconds` (latencia por ruta), y las de Node: event loop, heap, CPU y memoria.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Métricas por el proxy (se ocultan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Con X-Forwarded-For responde 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Forwarded-For",
                "value": "203.0.113.7"
              }
            ],
            "url": "{{baseUrl}}/metrics",
            "description": "nginx siempre añade `X-Forwarded-For`; Prometheus no. Así `/metrics` no se publica por el frontend.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "7. Endpoints de demo",
      "description": "Solo existen con TENANT_ENV=test (o sin TENANT_ENV y NODE_ENV distinto de production). Sirven para provocar a propósito errores 500 y latencia.",
      "item": [
        {
          "name": "Provocar un 500",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 500 a propósito', () => pm.response.to.have.status(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/demo/error",
            "description": "Quedará en `http_requests_total{status=\"500\"}`.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Respuesta lenta (300 ms)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Esperó lo pedido', () => pm.expect(pm.response.json().waitedMs).to.eql(300));",
                  "pm.test('La respuesta tardó al menos ~300 ms', () => pm.expect(pm.response.responseTime).to.be.at.least(250));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/demo/slow?ms=300",
            "description": "Sin `ms` espera 2000 ms.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "ms inválido (abc)",
          "event": [
            {
              "listen": "test",
              "script": {
