                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/modules/{{moduleId1}}/students/import",
            "description": "El borrador se reemplaza, así que no cuenta dos veces.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:/Marcelo/attendance-core/docs/excel-ejemplos/estudiantes.xlsx"
                }
              ]
            }
          }
        },
