    {
      "name": "5. Límite de estudiantes",
      "description": "El total son los estudiantes de los módulos no archivados. El Excel de ejemplo trae 5 estudiantes y el límite es 5. Si tu Postman no encuentra el archivo, vuelve a seleccionarlo en Body → form-data → file.",
      "item": [
        {
          "name": "Importar en el curso 1 (justo en el límite)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Se importa: 5 de 5 (201)', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('imported', String(pm.response.json().imported));",
                  "  pm.test('Entraron los 5 estudiantes del archivo', () => pm.expect(pm.response.json().imported).to.eql(5));",
                  "}"
                ]
