            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const text = pm.response.text();",
                  "pm.test('El 500 provocado está contado', () => pm.expect(text).to.match(/http_requests_total\\{method=\"GET\",route=\"\\/core\\/api\\/v1\\/demo\\/error\",status=\"500\"\\} [1-9]\\d*/));",
                  "pm.test('La latencia de /demo/slow está registrada', () => pm.expect(text).to.match(/http_request_duration_seconds_count\\{method=\"GET\",route=\"\\/core\\/api\\/v1\\/demo\\/slow\",status=\"200\"\\} [1-9]\\d*/));",
                  "pm.test('El 400 de ms inválido también', () => pm.expect(text).to.match(/route=\"\\/core\\/api\\/v1\\/demo\\/slow\",status=\"400\"/));"
                ]
              }
            }
          ],
          "request": {
