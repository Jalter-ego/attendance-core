            "description": "Guarda `imported`.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:/Marcelo/attendance-core/docs/excel-ejemplos/estudiantes.xlsx"
